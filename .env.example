  # .env.example
  # скопировать в .env
  # заполнить
  # chmod 600 .env
  # NVD_API_KEY запросить у https://nvd.nist.gov/developers/request-an-api-key
  NVD_API_KEY=

  APP_HOST_PORT=8080
  DB_HOST_PORT=5433

  # PROD
  PROD_DB=accounting_prod_db
  PROD_USER=accounting
  PROD_PASSWORD=<результат openssl rand -hex 32>

  # DEV (используется docker-compose и тестами)
  DEV_DB=accounting_dev_db
  DEV_USER=dev
  DEV_PASSWORD=<результат openssl rand -hex 32>

  # LOCAL
  LOCAL_DB=accounting_local_db
  LOCAL_USER=local
  LOCAL_PASSWORD=<результат openssl rand -hex 32>

  # API Tests
  TEST_BASE_URL=http://127.0.0.1:8080
  TEST_TIMEOUT_SECONDS=10

  # Spring Security Basic Auth
  TEST_USERNAME=user
  TEST_PASSWORD=<результат openssl rand -hex 32>

  # DB for Python tests (подключаются к DEV БД)
  TEST_DB_HOST=127.0.0.1
  TEST_DB_PORT=5433
  TEST_DB_NAME=accounting_dev_db
  TEST_DB_USER=dev
  TEST_DB_PASSWORD=<должен совпадать с DEV_PASSWORD>